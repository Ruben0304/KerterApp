<Page
    x:Class="KerterWin.Pages.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,4,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Partidos de hoy" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                <Button x:Name="RefreshButton" Click="OnRefresh" ToolTipService.ToolTip="Actualizar">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button ToolTipService.ToolTip="Ajustes">
                    <FontIcon Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="12" Width="280">
                                <ToggleSwitch x:Name="BoosterSwitch" Header="Acelerador de conexión"
                                              OnContent="Activado" OffContent="Desactivado" Toggled="OnBoosterToggled" />
                                <TextBlock Text="Graba el directo en tu PC con varias conexiones para evitar cortes."
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button Content="Cerrar sesión" HorizontalAlignment="Stretch" Click="OnSignOut" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Auto" Margin="0,0,0,12">
            <StackPanel x:Name="SportChips" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Sections" Spacing="20" Padding="0,0,0,32" />
        </ScrollViewer>

        <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsOpen="False" VerticalAlignment="Top" />
        <TextBlock x:Name="EmptyText" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                   Text="No hay partidos con transmisión hoy." />
    </Grid>
</Page>
