<Page
    x:Class="KerterWin.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="420" Margin="24,48,24,40" Spacing="28" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Kerter" FontSize="34" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="+" FontSize="34" FontWeight="Black"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <Border Background="White" CornerRadius="18" Padding="28">
                    <StackPanel Spacing="16" RequestedTheme="Light">
                        <TextBlock Text="miKerter" FontWeight="Bold" FontSize="15" Opacity="0.55" Foreground="Black" />
                        <TextBlock Text="Introduce tu correo para continuar" FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap" Foreground="Black" />
                        <TextBlock Text="Inicia sesión en Kerter+ con tu cuenta de miKerter."
                                   Opacity="0.55" TextWrapping="Wrap" Foreground="Black" />
                        <TextBox x:Name="EmailBox" Header="Correo" PlaceholderText="tu@correo.com" />
                        <PasswordBox x:Name="PasswordBox" Header="Contraseña" KeyDown="OnKeyDown" />
                        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
                        <Button x:Name="SignInButton" Content="Continuar" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" Padding="0,10" Click="OnSignIn" />
                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
