<Application
    x:Class="KerterWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="LiveBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="MutedBrush" Color="#99FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
